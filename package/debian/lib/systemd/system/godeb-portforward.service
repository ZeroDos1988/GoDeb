[Unit]
Description=GoDeb port forwarding (nftables NAT to WireGuard peers)
# Written by the GoDeb port forwarding plugin; absent until the first rule.
ConditionPathExists=/etc/godeb/portforward.nft
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/godeb/portforward.nft
ExecStop=-/usr/sbin/nft delete table ip godeb_portforward
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
